CLAUDE_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLAUDE_OAUTH_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
CLAUDE_REFRESH_MARGIN_MS = 5 * 60 * 1000
# Cloudflare in front of the token endpoint bans Python's default User-Agent (error 1010).
CLAUDE_USER_AGENT = f"omarchy-ai-usage/{APP_VERSION}"


def _usage_claude_credentials_path() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    return Path(os.path.expanduser(base)) / ".credentials.json"


def _usage_claude_refresh_login() -> bool:
    """Renew Claude Code's sign-in the way Claude Code does. Never logs tokens.

    Claude Code only refreshes while it runs, so a panel that just watches
    usage would find the token lapsed within hours and stop updating.
    """
    if not _usage_consented("claude"):
        return False
    path = _usage_claude_credentials_path()
    with _usage_renewal_lock("claude") as held:
        if not held:
            return False
        try:
            login = json.loads(path.read_text(encoding="utf-8")).get("claudeAiOauth")
        except Exception:
            return False
        if not isinstance(login, dict):
            return False
        refresh = str(login.get("refreshToken") or "").strip()
        if not refresh or _usage_number(login.get("expiresAt")) - CLAUDE_REFRESH_MARGIN_MS > time.time() * 1000:
            return False

        body = {"grant_type": "refresh_token", "refresh_token": refresh, "client_id": CLAUDE_OAUTH_CLIENT_ID}
        scopes = login.get("scopes")
        if isinstance(scopes, list) and scopes:
            body["scope"] = " ".join(str(scope) for scope in scopes)
        request = urllib.request.Request(
            CLAUDE_TOKEN_URL,
            data=json.dumps(body).encode("utf-8"),
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": CLAUDE_USER_AGENT,
            },
        )
        with _usage_hold_signals():
            try:
                with _usage_urlopen(request, timeout=30) as response:
                    payload = json.loads(response.read().decode("utf-8", errors="replace") or "{}")
            except Exception:
                return False
        if not isinstance(payload, dict):
            return False
        access = str(payload.get("access_token") or "").strip()
        try:
            expires_in = float(payload.get("expires_in") or 0)
        except (TypeError, ValueError):
            expires_in = 0.0
        if not access or expires_in <= 0:
            return False

        # A Claude Code that renewed meanwhile holds the newer pair; keep it.
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return False
        current = data.get("claudeAiOauth") if isinstance(data, dict) else None
        if not isinstance(current, dict) or current.get("refreshToken") != refresh:
            return False
        now_ms = time.time() * 1000
        current["accessToken"] = access
        current["refreshToken"] = str(payload.get("refresh_token") or refresh)
        current["expiresAt"] = int(now_ms + expires_in * 1000)
        refresh_life = _usage_number(payload.get("refresh_token_expires_in"))
        if refresh_life > 0:
            current["refreshTokenExpiresAt"] = int(now_ms + refresh_life * 1000)
        scope = payload.get("scope")
        if isinstance(scope, str) and scope.strip():
            current["scopes"] = scope.split()

        try:
            _usage_write_private_json(path, data)
        except OSError:
            return False
        return True


CLAUDE_SCOPED_WINDOWS = (
    (" Session", "Current session"),
    (" Weekly", "Current week"),
    (" Monthly", "Current month"),
)


def _usage_claude_reset_caption(resets_at: Any) -> str:
    """Windows closing within a day read better as a clock time than a date."""
    reset_ts = _usage_parse_updated_at(resets_at)
    if reset_ts is None:
        return ""
    seconds_left = reset_ts - time.time()
    if seconds_left <= 0:
        return ""
    if seconds_left >= 86400:
        return _usage_reset_caption(resets_at)
    reset_local = time.localtime(reset_ts)
    clock = time.strftime("%H:%M", reset_local)
    if reset_local[:3] != time.localtime()[:3]:
        clock = "tomorrow " + clock
    minutes = int(seconds_left // 60)
    if minutes < 1:
        return f"Resets {clock}"
    if minutes < 60:
        return f"Resets {clock} ({minutes} min left)"
    return f"Resets {clock} ({minutes // 60} h {minutes % 60} min left)"


def _usage_claude_panel_limits(limits: list[dict]) -> list[dict]:
    """Map omarchy-agent-usage-claude windows onto claude.ai's usage wording."""
    rows: list[dict] = []
    for entry in limits:
        percent = _usage_limit_percent(entry)
        if percent is None:
            continue
        label = str(entry.get("title") or entry.get("label") or "").strip()
        bar_style = "accent"
        if label.startswith("Session ("):
            label = "Current session"
        elif label.startswith("Weekly ("):
            label = "Current week · All models"
        else:
            # Model-scoped windows arrive as "<model> <Window>", e.g. "Opus 5 Weekly".
            for suffix, window in CLAUDE_SCOPED_WINDOWS:
                if label.endswith(suffix) and len(label) > len(suffix):
                    label = f"{window} · {label[: -len(suffix)].strip()}"
                    break
            bar_style = "muted"
        resets_at = entry.get("resetsAt")
        rows.append(
            _usage_panel_limit(
                label or "Usage",
                percent,
                bar_style=bar_style,
                caption=_usage_claude_reset_caption(resets_at),
                resets_at=resets_at,
            )
        )
    return rows


def _usage_claude_checked_ago() -> str:
    cache = (
        Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
        / "omarchy" / "agent-usage" / "claude-limits.json"
    )
    try:
        fetched = float(json.loads(cache.read_text(encoding="utf-8")).get("fetchedAtMs") or 0) / 1000
    except Exception:
        return ""
    if fetched <= 0:
        return ""
    minutes = max(0, int((time.time() - fetched) // 60))
    if minutes < 60:
        return f"{minutes} min ago"
    if minutes < 48 * 60:
        return f"{minutes // 60} h ago"
    return f"{minutes // 1440} days ago"


def _usage_claude_notice(usage_status: str, panel_limits: list[dict]) -> str:
    """The collector keeps its last numbers once the sign-in lapses; say so."""
    if not panel_limits or usage_status.lower() != "sign-in expired":
        return ""
    ago = _usage_claude_checked_ago()
    checked = f"Last checked {ago}" if ago else "Last known numbers"
    return f"{checked}: Claude Code's sign-in expired. Start Claude Code or run `claude auth login` to refresh."


