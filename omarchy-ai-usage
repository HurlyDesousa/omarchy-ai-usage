class _RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """urllib keeps Authorization (and resends bodies) across redirects, even to
    another host. Every request here carries a token, so no redirect is followed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_USAGE_OPENER = urllib.request.build_opener(_RefuseRedirects)
# Real responses are a few KB; a hostile endpoint must not fill memory.
USAGE_MAX_RESPONSE_BYTES = 1 << 20
# Whole-update budget; per-socket timeouts do not bound a chain of requests.
USAGE_UPDATE_DEADLINE_SECONDS = 90


class _CappedResponse:
    def __init__(self, response):
        self._response = response

    def __enter__(self):
        return self

    def __exit__(self, *exc_info):
        self._response.close()

    def __getattr__(self, name):
        return getattr(self._response, name)

    def read(self, *_args) -> bytes:
        length = str(self._response.headers.get("Content-Length") or "").strip()
        if length.isdigit() and int(length) > USAGE_MAX_RESPONSE_BYTES:
            raise ValueError("response too large")
        data = self._response.read(USAGE_MAX_RESPONSE_BYTES + 1)
        if len(data) > USAGE_MAX_RESPONSE_BYTES:
            raise ValueError("response too large")
        return data


def _usage_urlopen(request: urllib.request.Request, timeout: float):
    return _CappedResponse(_USAGE_OPENER.open(request, timeout=timeout))


class _UsageDeadline(Exception):
    pass


@contextlib.contextmanager
def _usage_hold_signals():
    """A token refresh rotates the refresh token on the server: dying between
    the POST and saving the new pair would sign that app out. Termination and
    the update deadline wait until the block ends."""
    held = {signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGALRM}
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, held)
    try:
        yield
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


@contextlib.contextmanager
def _usage_renewal_lock(name: str, wait_seconds: float = 10.0):
    """Yield True while holding this sign-in's renewal lock, False if busy."""
    lock_dir = STATE_HOME / "omarchy" / "ai-usage" / "locks"
    fd = -1
    try:
        lock_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(
            lock_dir / f"{name}.lock",
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
    except OSError:
        yield False
        return
    try:
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    yield False
                    return
                time.sleep(0.2)
        yield True
    finally:
        os.close(fd)


def _usage_now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _usage_today() -> str:
    return time.strftime("%Y-%m-%d")


def _usage_number(value) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError, OverflowError):
        return 0


def _usage_base_record(agent_id: str) -> dict:
    return {
        "schemaVersion": 1,
        "id": agent_id,
        "name": AGENT_USAGE_NAMES.get(agent_id, agent_id),
        "updatedAt": _usage_now_iso(),
        "ready": False,
        "hasLocalStats": False,
        "tierLabel": "",
        "usageStatusText": "unavailable",
        "authHelpText": "",
        "limits": [],
        "todayTotalTokens": 0,
        "todayPrompts": 0,
        "todaySessions": 0,
        "recentDays": [],
        "modelUsage": {},
    }


def _usage_record_score(record: dict | None) -> int:
    if not record:
        return 0
    score = 0
    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    if limits:
        score += 10 + len(limits)
    if record.get("ready") is True:
        score += 4
    if record.get("hasLocalStats") is True:
        score += 2
    if _usage_number(record.get("todayTotalTokens")) > 0:
        score += 1
    if str(record.get("tierLabel") or "").strip():
        score += 1
    status = str(record.get("usageStatusText") or "").lower()
    if "unavailable" in status or "not loaded" in status or status == "unavailable":
        score -= 6
    return score


def _usage_load_state_file(path: Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _usage_read_record(agent_id: str) -> dict | None:
    record = _usage_load_state_file(USAGE_STATE_DIR / f"{agent_id}.json")
    return _usage_normalize_record(agent_id, record) if record is not None else None


def _usage_normalize_record(agent_id: str, record: dict) -> dict:
    normalized = dict(record)
    normalized["id"] = agent_id
    name = str(normalized.get("name") or "").strip()
    if not name:
        normalized["name"] = AGENT_USAGE_NAMES.get(agent_id, agent_id)
    elif agent_id == "grok" and name in (
        "Grok",
        "Grok Build",
        "Grok (grok build)",
        "Grok (chat and build)",
    ):
        normalized["name"] = AGENT_USAGE_NAMES["grok"]
    return normalized


def _usage_write_record(agent_id: str, record: dict) -> None:
    try:
        USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = USAGE_STATE_DIR / f".{agent_id}.{os.getpid()}.tmp"
        payload = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
        tmp.write_text(payload + "\n", encoding="utf-8")
        tmp.replace(USAGE_STATE_DIR / f"{agent_id}.json")
    except Exception:
        pass


def _usage_claude_collector() -> Path:
    # Omarchy's own collector, by absolute path: a PATH search would let any
    # file in ~/.local/bin stand in for it.
    return Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "bin" / "omarchy-agent-usage-claude"


def _usage_run_claude_collector(*args: str) -> tuple[bool, str]:
    collector = _usage_claude_collector()
    if not collector.is_file():
        return False, f"{collector} not found"
    try:
        proc = subprocess.run(
            [str(collector), *args],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except Exception as exc:
        return False, f"{collector.name}: {exc}"
    record = (proc.stdout or "").strip()
    if proc.returncode != 0 or not record:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        return False, f"{collector.name}: {detail[-1] if detail else f'exit {proc.returncode}'}"
    try:
        parsed = json.loads(record)
    except json.JSONDecodeError as exc:
        return False, f"{collector.name}: invalid JSON ({exc})"
    if not isinstance(parsed, dict):
        return False, f"{collector.name}: unexpected record type"
    _usage_write_record("claude", _usage_normalize_record("claude", parsed))
    return True, ""


def _usage_parse_updated_at(value: Any) -> float | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    try:
        if raw.endswith("Z"):
            raw = raw[:-1] + "+00:00"
        dt = datetime.fromisoformat(raw)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.timestamp()
    except (ValueError, OverflowError, OSError):
        return None


def _usage_record_is_stale(record: dict | None) -> bool:
    if not record:
        return True
    updated = _usage_parse_updated_at(record.get("updatedAt"))
    if updated is None:
        return True
    return (time.time() - updated) > USAGE_STALE_SECONDS


def _usage_jwt_is_expired(token: str) -> bool:
    parts = str(token or "").split(".")
    if len(parts) < 2:
        return True
    try:
        padded = parts[1] + "=" * (-len(parts[1]) % 4)
        payload = json.loads(base64.urlsafe_b64decode(padded.encode("ascii")))
        exp = payload.get("exp")
        if exp is None:
            return False
        return float(exp) <= time.time()
    except Exception:
        return False


def _usage_read_cursor_item(key: str) -> str:
    for db in _usage_cursor_vscdb_paths():
        try:
            import sqlite3

            conn = sqlite3.connect(f"file:{db.resolve()}?mode=ro", uri=True, timeout=3)
            conn.execute("PRAGMA query_only = ON")
            row = conn.execute(
                "SELECT value FROM ItemTable WHERE key = ? LIMIT 1",
                (key,),
            ).fetchone()
            conn.close()
        except Exception:
            continue
        if not row or row[0] is None:
            continue
        value = row[0]
        if isinstance(value, bytes):
            value = value.decode("utf-8", errors="replace")
        token = str(value).strip()
        if token:
            return token
    return ""


def _usage_read_cursor_access_token() -> str:
    return _usage_read_cursor_item(CURSOR_ACCESS_TOKEN_KEY)


_CURSOR_BEARER: str | None = None


def _usage_cursor_bearer() -> str:
    """Cursor's own access token while it is valid, else "".

    Never minted from Cursor's refresh token: if the server rotates refresh
    tokens, the copy Cursor holds would stop working and sign Cursor out.
    Cursor renews its token itself whenever it runs."""
    global _CURSOR_BEARER
    if _CURSOR_BEARER is None:
        token = _usage_read_cursor_access_token()
        _CURSOR_BEARER = token if token and not _usage_jwt_is_expired(token) else ""
    return _CURSOR_BEARER


def _usage_cursor_http_json(url: str, token: str) -> dict | None:
    if not token:
        return None
    request = urllib.request.Request(
        url,
        data=b"{}",
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Connect-Protocol-Version": "1",
            "User-Agent": CURSOR_DASHBOARD_USER_AGENT,
        },
    )
    try:
        with _usage_urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8", errors="replace") or "{}")
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
        return None
    return payload if isinstance(payload, dict) else None


def _usage_cursor_any_to_iso(value: Any) -> str:
    if value is None or value == "":
        return ""
    if isinstance(value, dict):
        seconds = value.get("seconds")
        if seconds is None:
            seconds = value.get("val")
        if seconds is None:
            return ""
        value = seconds
    # Cursor sends epoch milliseconds as a string.
    if isinstance(value, str) and value.strip().isdigit():
        value = int(value.strip())
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 1_000_000_000_000:
            ts /= 1000.0
        try:
            return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))
        except (OverflowError, OSError, ValueError):
            return ""
    raw = str(value).strip()
    if "T" in raw or (len(raw) >= 10 and raw[4] == "-" and raw[7] == "-"):
        return raw
    return ""


def _usage_fraction_from_percent_value(value: Any) -> float | None:
    try:
        percent = float(value)
    except (TypeError, ValueError):
        return None
    if percent != percent:
        return None
    if percent > 1:
        percent /= 100.0
    return min(1.0, max(0.0, percent))


def _usage_cursor_settings_percent(value: Any) -> float | None:
    """Parse Cursor Settings percent fields (1 == 1% used)."""
    try:
        percent = float(value)
    except (TypeError, ValueError):
        return None
    if percent != percent or percent < 0:
        return None
    if percent == 0:
        return 0.0
    # Integer 1–100 from Plan & Usage, or already a 0–1 fraction.
    if percent > 1:
        percent /= 100.0
    elif percent == 1:
        percent = 0.01
    return min(1.0, max(0.0, percent))


def _usage_cursor_spend_fractions(plan: dict) -> tuple[float | None, float | None]:
    auto_frac: float | None = None
    api_frac: float | None = None
    try:
        limit = float(plan.get("limit") or 0)
    except (TypeError, ValueError):
        limit = 0.0
    if limit <= 0:
        return None, None
    try:
        included = float(plan.get("includedSpend") or plan.get("included_spend") or 0)
        if included >= 0:
            auto_frac = min(1.0, max(0.0, included / limit))
    except (TypeError, ValueError):
        pass
    try:
        total = float(plan.get("totalSpend") or plan.get("total_spend") or 0)
        included = float(plan.get("includedSpend") or plan.get("included_spend") or 0)
        api_spend = max(0.0, total - included)
        api_frac = min(1.0, max(0.0, api_spend / limit))
    except (TypeError, ValueError):
        pass
    return auto_frac, api_frac


def _usage_cursor_message_percent(text: Any) -> float | None:
    found = re.findall(r"(\d+(?:\.\d+)?)%", str(text or ""))
    if not found:
        return None
    return _usage_cursor_settings_percent(found[0])


def _usage_cursor_plan_fractions(plan: dict) -> tuple[float | None, float | None]:
    """Fallback percents from planUsage when display messages are absent."""
    auto_frac = _usage_cursor_settings_percent(
        plan.get("autoPercentUsed", plan.get("auto_percent_used"))
    )
    api_frac = _usage_cursor_settings_percent(
        plan.get("apiPercentUsed", plan.get("api_percent_used"))
    )
    return auto_frac, api_frac


def _usage_cursor_tier_label(*candidates: Any) -> str:
    for raw in candidates:
        text = str(raw or "").strip()
        if not text:
            continue
        key = text.lower().replace(" ", "_")
        if key in CURSOR_TIER_LABELS:
            return CURSOR_TIER_LABELS[key]
        for needle, label in CURSOR_TIER_LABELS.items():
            if needle in key:
                return label
        if text[0].isupper():
            return text
    return ""


def _usage_fetch_cursor_dashboard(token: str) -> dict | None:
    request = urllib.request.Request(
        CURSOR_DASHBOARD_USAGE_URL,
        data=b"{}",
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Connect-Protocol-Version": "1",
            "User-Agent": CURSOR_DASHBOARD_USER_AGENT,
        },
    )
    try:
        with _usage_urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8", errors="replace"))
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
        return None
    if not isinstance(payload, dict):
        return None

    body = payload.get("result") if isinstance(payload.get("result"), dict) else payload
    plan = body.get("planUsage") if isinstance(body.get("planUsage"), dict) else None
    if not isinstance(plan, dict):
        return None

    auto_frac = _usage_cursor_message_percent(
        body.get("autoModelSelectedDisplayMessage")
    )
    if auto_frac is None:
        auto_frac = _usage_cursor_message_percent(body.get("displayMessage"))
    api_frac = _usage_cursor_message_percent(
        body.get("namedModelSelectedDisplayMessage")
    )
    plan_auto, plan_api = _usage_cursor_plan_fractions(plan)
    if auto_frac is None:
        auto_frac = plan_auto
    if api_frac is None:
        api_frac = plan_api
    reset_iso = _usage_cursor_any_to_iso(body.get("billingCycleEnd", body.get("billing_cycle_end")))

    limits: list[dict] = []
    if auto_frac is not None:
        limits.append(
            {
                "label": "Cursor Models",
                "title": "Cursor Models",
                "percent": auto_frac,
                "resetsAt": reset_iso,
            }
        )
    if api_frac is not None:
        limits.append(
            {
                "label": "Other Models",
                "title": "Other Models",
                "percent": api_frac,
                "resetsAt": reset_iso,
            }
        )
    if not limits:
        return None

    tier = _usage_cursor_tier_label(
        body.get("membershipType"),
        body.get("membership_type"),
        plan.get("membershipType"),
        plan.get("membership_type"),
    )
    info_payload = _usage_cursor_http_json(CURSOR_PLAN_INFO_URL, token)
    if isinstance(info_payload, dict):
        info_body = (
            info_payload.get("result")
            if isinstance(info_payload.get("result"), dict)
            else info_payload
        )
        info = info_body.get("planInfo") if isinstance(info_body.get("planInfo"), dict) else info_body
        if isinstance(info, dict):
            tier = _usage_cursor_tier_label(
                info.get("planName"),
                info.get("plan_name"),
                info.get("membershipType"),
                info.get("membership_type"),
                tier,
            ) or tier
            if not reset_iso:
                reset_iso = _usage_cursor_any_to_iso(
                    info.get("billingCycleEnd", info.get("billing_cycle_end"))
                )
    record = _usage_base_record("cursor")
    record.update(
        {
            "ready": True,
            "hasLocalStats": False,
            "usageStatusText": "",
            "authHelpText": "Live Cursor dashboard quota",
            "limits": limits,
            "tierLabel": tier,
            "updatedAt": _usage_now_iso(),
        }
    )
    return record


def _usage_fetch_cursor_live() -> dict | None:
    token = _usage_cursor_bearer()
    if not token:
        return None
    return _usage_fetch_cursor_dashboard(token)


def _usage_cursor_sand_usage() -> dict | None:
    payload = _usage_cursor_http_json(CURSOR_SAND_USAGE_URL, _usage_cursor_bearer())
    if not isinstance(payload, dict):
        return None
    body = payload.get("result") if isinstance(payload.get("result"), dict) else payload
    if not isinstance(body, dict):
        return None
    percent = None
    for key in (
        "usagePercent",
        "usage_percent",
        "percentUsed",
        "percent_used",
        "includedUsagePercent",
        "included_usage_percent",
        "percent",
    ):
        percent = _usage_fraction_from_percent_value(body.get(key))
        if percent is not None:
            break
    if percent is None:
        return None
    resets = ""
    for key in (
        "nextResetTimestampUtc",
        "next_reset_timestamp_utc",
        "nextResetAt",
        "next_reset_at",
        "resetAt",
        "reset_at",
    ):
        resets = _usage_cursor_any_to_iso(body.get(key))
        if resets:
            break
    return {"percent": percent, "resets_at": resets}


def _usage_collect_grokbot_local() -> dict:
    record = _usage_base_record("grokbot")
    sand = _usage_cursor_sand_usage()
    if sand and sand.get("percent") is not None:
        limit = {
            "label": "Weekly usage",
            "title": "Weekly usage",
            "percent": sand["percent"],
        }
        resets = str(sand.get("resets_at") or "").strip()
        if resets:
            limit["resetsAt"] = resets
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "",
                "authHelpText": "",
                "limits": [limit],
            }
        )
        return record
    record["usageStatusText"] = "Grok Bot usage unavailable"
    record["authHelpText"] = (
        "Sign in to Cursor on this machine, then refresh. "
        "Grok Bot weekly usage comes from the Cursor spending page."
    )
    return record


def _usage_merge_model_usage(left: dict, right: dict) -> dict:
    merged = {key: dict(value) for key, value in left.items() if isinstance(value, dict)}
    for model, bucket in right.items():
        if not isinstance(bucket, dict):
            continue
        target = merged.setdefault(
            model,
            {
                "inputTokens": 0,
                "outputTokens": 0,
                "cacheReadInputTokens": 0,
                "cacheCreationInputTokens": 0,
            },
        )
        for field in target:
            target[field] = _usage_number(target.get(field)) + _usage_number(bucket.get(field))
    return merged


def _usage_merge_records(
    primary: dict | None,
    secondary: dict | None,
    *,
    agent_id: str,
) -> dict:
    if primary is None and secondary is None:
        return _usage_base_record(agent_id)
    if primary is None:
        return dict(secondary or _usage_base_record(agent_id))
    if secondary is None:
        return dict(primary)

    merged = dict(primary)
    primary_limits = primary.get("limits") if isinstance(primary.get("limits"), list) else []
    secondary_limits = secondary.get("limits") if isinstance(secondary.get("limits"), list) else []
    if secondary_limits and (not primary_limits or _usage_record_score(secondary) > _usage_record_score(primary)):
        merged["limits"] = secondary_limits
    elif primary_limits:
        merged["limits"] = primary_limits

    for field in ("tierLabel", "usageStatusText", "authHelpText"):
        if not str(merged.get(field) or "").strip() and str(secondary.get(field) or "").strip():
            merged[field] = secondary[field]

    for field in ("todayTotalTokens", "todayPrompts", "todaySessions"):
        merged[field] = max(_usage_number(merged.get(field)), _usage_number(secondary.get(field)))

    left_models = merged.get("modelUsage") if isinstance(merged.get("modelUsage"), dict) else {}
    right_models = secondary.get("modelUsage") if isinstance(secondary.get("modelUsage"), dict) else {}
    if right_models:
        merged["modelUsage"] = _usage_merge_model_usage(left_models, right_models)

    merged["ready"] = bool(merged.get("ready")) or bool(secondary.get("ready"))
    merged["hasLocalStats"] = bool(merged.get("hasLocalStats")) or bool(secondary.get("hasLocalStats"))

    primary_updated = _usage_parse_updated_at(primary.get("updatedAt"))
    secondary_updated = _usage_parse_updated_at(secondary.get("updatedAt"))
    if secondary_updated is not None and (primary_updated is None or secondary_updated > primary_updated):
        merged["updatedAt"] = secondary.get("updatedAt")
    return merged


def _usage_add_tokens(
    day: str,
    model: str,
    tokens: int,
    *,
    today: str,
    today_tokens: int,
    total_tokens: int,
    model_usage: dict,
) -> tuple[int, int]:
    if tokens <= 0:
        return today_tokens, total_tokens
    total_tokens += tokens
    if day == today:
        today_tokens += tokens
    bucket = model_usage.setdefault(
        model,
        {
            "inputTokens": 0,
            "outputTokens": 0,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0,
        },
    )
    bucket["outputTokens"] = _usage_number(bucket.get("outputTokens")) + tokens
    return today_tokens, total_tokens


def _usage_cursor_vscdb_paths() -> list[Path]:
    home = Path.home()
    candidates: list[Path] = [
        home / ".config/Cursor/User/globalStorage/state.vscdb",
        home / ".config/cursor/User/globalStorage/state.vscdb",
        home / ".cursor/User/globalStorage/state.vscdb",
        home / "snap/cursor/current/.config/Cursor/User/globalStorage/state.vscdb",
    ]
    for pattern in (
        ".config/*/User/globalStorage/state.vscdb",
        ".var/app/*/config/Cursor/User/globalStorage/state.vscdb",
        "snap/cursor/*/.config/Cursor/User/globalStorage/state.vscdb",
    ):
        for path in home.glob(pattern):
            if "ursor" in str(path).lower():
                candidates.append(path)
    seen: set[str] = set()
    found: list[Path] = []
    for path in candidates:
        key = str(path.resolve()) if path.exists() else str(path)
        if key in seen:
            continue
        seen.add(key)
        if path.is_file():
            found.append(path)
    return found


def _usage_scan_cursor_vscdb(db: Path, today: str) -> tuple[int, int, int, dict]:
    today_tokens = 0
    total_tokens = 0
    prompts = 0
    model_usage: dict = {}
    import sqlite3

    conn = sqlite3.connect(f"file:{db.resolve()}?mode=ro", uri=True, timeout=3)
    conn.execute("PRAGMA query_only = ON")
    rows = conn.execute("SELECT key, value FROM ItemTable").fetchall()
    conn.close()

    token_key_re = re.compile(r"token|usage|composer", re.IGNORECASE)
    for key, value in rows:
        if value is None:
            continue
        key_s = str(key or "")
        text = value.decode("utf-8", errors="replace") if isinstance(value, bytes) else str(value)
        if not token_key_re.search(key_s) and "composer" not in text[:200].lower():
            continue
        try:
            payload = json.loads(text)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue

        candidates = [payload]
        if isinstance(payload.get("composerData"), dict):
            candidates.append(payload["composerData"])

        for item in candidates:
            breakdown = item.get("promptTokenBreakdown") or item.get("tokenBreakdown") or {}
            if isinstance(breakdown, dict):
                tokens = sum(_usage_number(v) for v in breakdown.values())
            else:
                tokens = _usage_number(item.get("totalTokens") or item.get("tokens"))
            if tokens <= 0:
                usage = item.get("usage") or {}
                tokens = _usage_number(usage.get("totalTokens") or usage.get("total_tokens"))
            if tokens <= 0:
                continue
            prompts += 1
            model = str(item.get("model") or item.get("modelName") or "cursor")
            today_tokens, total_tokens = _usage_add_tokens(
                today,
                model,
                tokens,
                today=today,
                today_tokens=today_tokens,
                total_tokens=total_tokens,
                model_usage=model_usage,
            )
    return today_tokens, total_tokens, prompts, model_usage


GROK_PROXY_BASE = "https://cli-chat-proxy.grok.com/v1"
GROK_TOKEN_AUTH = "xai-grok-cli"
GROK_TOKEN_ENDPOINT = "https://auth.x.ai/oauth2/token"
GROK_CREDITS_URL = "https://grok.com/grok_api_v2.GrokBuildBilling/GetGrokCreditsConfig"


def _usage_grok_home() -> Path:
    return Path(os.environ.get("GROK_HOME", str(Path.home() / ".grok")))


def _usage_field(data: dict, *names: str):
    for name in names:
        if name in data and data[name] is not None:
            return data[name]
    return None


def _usage_grok_auth_data() -> dict:
    path = _usage_grok_home() / "auth.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _usage_grok_auth_creds() -> tuple[str, str]:
    ranked: list[tuple[int, int, str, str]] = []
    for issuer, entry in _usage_grok_auth_data().items():
        if not isinstance(entry, dict):
            continue
        token = str(entry.get("key") or "").strip()
        if not token:
            continue
        user_id = str(entry.get("user_id") or "").strip()
        expired = 1 if _usage_jwt_is_expired(token) else 0
        preferred = 0 if str(issuer).startswith("https://auth.x.ai") else 1
        ranked.append((expired, preferred, token, user_id))
    if not ranked:
        return "", ""
    ranked.sort()
    return ranked[0][2], ranked[0][3]


def _usage_grok_write_auth(data: dict) -> None:
    path = _usage_grok_home() / "auth.json"
    _usage_write_private_json(path, data, indent=2)


def _usage_write_private_json(path: Path, data: dict, indent: int | None = None) -> None:
    """Atomically replace a credential file, keeping it owner-only (0600).

    The temp file is new (mkstemp: O_EXCL, 0600) and synced before the rename,
    so a crash or power cut leaves the old file or the new one, never a
    truncated or world-readable one."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data, indent=indent) + ("\n" if indent else ""))
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    with contextlib.suppress(OSError):
        dir_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)


def _usage_load_consent() -> dict:
    try:
        renew = json.loads(CONSENT_FILE.read_text(encoding="utf-8")).get("renew")
    except Exception:
        return {}
    return renew if isinstance(renew, dict) else {}


def _usage_consented(provider: str) -> bool:
    """Renewing a sign-in rewrites another app's credential file: only with consent."""
    return _usage_load_consent().get(provider) is True


def _usage_grok_refresh_auth() -> bool:
    """Silently refresh grok login via OIDC. Never logs tokens.

    Only xAI-issued entries are touched, and the file is re-read under a lock
    after the network call: a grok login that happened meanwhile is kept.
    """
    if not _usage_consented("grok"):
        return False
    needs_refresh = False
    for issuer, entry in _usage_grok_auth_data().items():
        if not isinstance(entry, dict) or not str(issuer).startswith("https://auth.x.ai"):
            continue
        token = str(entry.get("key") or "").strip()
        if not token or _usage_jwt_is_expired(token):
            needs_refresh = True
            break
    if not needs_refresh:
        return False

    with _usage_renewal_lock("grok") as held:
        if not held:
            return False
        data = _usage_grok_auth_data()
        if not data:
            return False
        refreshed: dict[str, dict] = {}
        for issuer, entry in data.items():
            if not isinstance(entry, dict) or not str(issuer).startswith("https://auth.x.ai"):
                continue
            token = str(entry.get("key") or "").strip()
            if token and not _usage_jwt_is_expired(token):
                continue
            refresh = str(entry.get("refresh_token") or "").strip()
            client_id = str(entry.get("oidc_client_id") or entry.get("client_id") or "").strip()
            if not client_id and "::" in str(issuer):
                client_id = str(issuer).split("::", 1)[1].strip()
            if not refresh or not client_id:
                continue
            body = urllib.parse.urlencode(
                {"grant_type": "refresh_token", "refresh_token": refresh, "client_id": client_id}
            ).encode("utf-8")
            req = urllib.request.Request(
                GROK_TOKEN_ENDPOINT,
                data=body,
                method="POST",
                headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
            )
            with _usage_hold_signals():
                try:
                    with _usage_urlopen(req, timeout=20) as resp:
                        payload = json.loads(resp.read().decode("utf-8", errors="replace") or "{}")
                except Exception:
                    continue
                if not isinstance(payload, dict):
                    continue
                new_token = str(payload.get("access_token") or "").strip()
                if not new_token:
                    continue
                refreshed[str(issuer)] = payload

        if not refreshed:
            return False
        # A grok login during the request holds the newer pair; keep it.
        current = _usage_grok_auth_data()
        changed = False
        for issuer, payload in refreshed.items():
            entry = current.get(issuer)
            if not isinstance(entry, dict) or entry.get("refresh_token") != data[issuer].get("refresh_token"):
                continue
            entry["key"] = str(payload.get("access_token") or "")
            new_refresh = str(payload.get("refresh_token") or "").strip()
            if new_refresh:
                entry["refresh_token"] = new_refresh
            try:
                expires_in = float(payload.get("expires_in") or 0)
            except (TypeError, ValueError):
                expires_in = 0.0
            if expires_in > 0:
                entry["expires_at"] = int(time.time()) + int(expires_in)
            changed = True
        if not changed:
            return False
        try:
            _usage_grok_write_auth(current)
        except OSError:
            return False
        return True


def _usage_grok_client_version() -> str:
    path = _usage_grok_home() / "version.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return ""
    if not isinstance(data, dict):
        return ""
    return str(data.get("version") or data.get("clientVersion") or "").strip()


def _usage_grok_proxy_json(
    path: str,
    surface: str = "interactive",
    *,
    _retried: bool = False,
) -> dict | None:
    token, user_id = _usage_grok_auth_creds()
    if not token:
        return None
    if _usage_jwt_is_expired(token) and not _retried:
        if _usage_grok_refresh_auth():
            return _usage_grok_proxy_json(path, surface, _retried=True)
    version = _usage_grok_client_version() or "1.0.13"
    headers = {
        "Authorization": f"Bearer {token}",
        "X-XAI-Token-Auth": GROK_TOKEN_AUTH,
        "Accept": "application/json",
        "User-Agent": f"grok/{version}",
        "x-grok-client-version": version,
        "x-grok-client-mode": surface if surface in ("interactive", "headless") else "interactive",
    }
    if user_id:
        headers["x-userid"] = user_id
    req = urllib.request.Request(
        f"{GROK_PROXY_BASE}{path}",
        method="GET",
        headers=headers,
    )
    try:
        with _usage_urlopen(req, timeout=20) as resp:
            payload = json.loads(resp.read().decode("utf-8", errors="replace") or "{}")
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403) and not _retried and _usage_grok_refresh_auth():
            return _usage_grok_proxy_json(path, surface, _retried=True)
        return None
    except Exception:
        return None
    return payload if isinstance(payload, dict) else None


def _usage_supergrok_percent_value(value: Any) -> float | None:
    """SuperGrok billing percents are 0–100 (1 == 1% used)."""
    return _usage_cursor_settings_percent(value)


def _usage_supergrok_product_kind(name: str) -> str:
    key = str(name or "").lower().replace("_", "").replace(" ", "")
    if "build" in key:
        return "build"
    if "chat" in key:
        return "chat"
    if key in ("api", "productapi"):
        return "chat"
    return "other"


def _usage_supergrok_weekly_parts(config: dict) -> dict[str, float | None]:
    """Weekly SuperGrok parts: Chat + Grok Build. Not Cursor Grok."""
    credit = _usage_supergrok_percent_value(
        _usage_field(config, "creditUsagePercent", "credit_usage_percent")
    )
    chat: float | None = None
    build: float | None = None
    others: list[float] = []
    products = _usage_field(config, "productUsage", "product_usage")
    if isinstance(products, list):
        for item in products:
            if not isinstance(item, dict):
                continue
            frac = _usage_supergrok_percent_value(
                _usage_field(item, "usagePercent", "usage_percent", "percent")
            )
            if frac is None:
                continue
            kind = _usage_supergrok_product_kind(
                str(_usage_field(item, "product", "name", "label") or "")
            )
            if kind == "build":
                build = frac if build is None else min(1.0, build + frac)
            elif kind == "chat":
                chat = frac if chat is None else min(1.0, chat + frac)
            else:
                others.append(frac)
    combined: float | None = None
    if chat is not None and build is not None:
        combined = min(1.0, max(0.0, chat + build))
    elif others and (chat is not None or build is not None):
        combined = min(1.0, max(0.0, sum(others) + (chat or 0.0) + (build or 0.0)))
    return {
        "credit": credit,
        "chat": chat,
        "build": build,
        "combined": combined,
    }


def _usage_supergrok_weekly_fraction(config: dict) -> float | None:
    parts = _usage_supergrok_weekly_parts(config)
    combined = parts.get("combined")
    credit = parts.get("credit")
    if combined is not None and credit is not None:
        return max(float(combined), float(credit))
    if combined is not None:
        return float(combined)
    if credit is not None:
        return float(credit)
    chat = parts.get("chat")
    if chat is not None:
        return float(chat)
    build = parts.get("build")
    if build is not None:
        return float(build)
    return None


def _usage_plan_share_meta(product: str) -> tuple[str, str, str]:
    """Map billing product ids onto dashboard labels and bar styles."""
    key = str(product or "").lower().replace("_", "").replace(" ", "").replace("-", "")
    if key in ("cursor", "productcursor"):
        return "cursor", "Cursor", "accent"
    if key in ("grokbot", "bot", "sand"):
        return "grokbot", "Grok Bot", "grokbot"
    if key in ("grokchat", "chat", "productapi", "api"):
        return "chat", "Chat", "muted"
    if "build" in key:
        return "build", "Build", "grokbot"
    label = str(product or "Other").strip() or "Other"
    return key or "other", label, "muted"


def _usage_plan_shares_from_config(config: dict) -> list[dict[str, Any]]:
    """Absolute weekly-pool shares from unified SpaceXAI productUsage."""
    products = _usage_field(config, "productUsage", "product_usage")
    if not isinstance(products, list):
        return []
    shares: list[dict[str, Any]] = []
    seen: set[str] = set()
    for item in products:
        if not isinstance(item, dict):
            continue
        percent = _usage_supergrok_percent_value(
            _usage_field(item, "usagePercent", "usage_percent", "percent")
        )
        if percent is None:
            continue
        share_id, label, bar_style = _usage_plan_share_meta(
            str(_usage_field(item, "product", "name", "label") or "")
        )
        if share_id in seen:
            for existing in shares:
                if existing["id"] == share_id:
                    existing["percent"] = max(float(existing["percent"]), float(percent))
                    break
            continue
        seen.add(share_id)
        shares.append(
            {
                "id": share_id,
                "label": label,
                "percent": float(percent),
                "barStyle": bar_style,
            }
        )
    order = {"cursor": 0, "grokbot": 1, "chat": 2, "build": 3}
    shares.sort(key=lambda row: (order.get(str(row["id"]), 50), str(row["label"])))
    return shares


def _usage_proto_varint(data: bytes, pos: int) -> tuple[int, int]:
    value = 0
    shift = 0
    while pos < len(data):
        byte = data[pos]
        pos += 1
        value |= (byte & 0x7F) << shift
        if not (byte & 0x80):
            return value, pos
        shift += 7
        if shift > 70:
            break
    return value, pos


def _usage_proto_fields(data: bytes):
    pos = 0
    while pos < len(data):
        key, pos = _usage_proto_varint(data, pos)
        number = key >> 3
        wire = key & 0x07
        if wire == 0:
            value, pos = _usage_proto_varint(data, pos)
            yield number, wire, value
        elif wire == 1:
            if pos + 8 > len(data):
                return
            yield number, wire, data[pos : pos + 8]
            pos += 8
        elif wire == 2:
            length, pos = _usage_proto_varint(data, pos)
            if pos + length > len(data):
                return
            yield number, wire, data[pos : pos + length]
            pos += length
        elif wire == 5:
            if pos + 4 > len(data):
                return
            yield number, wire, data[pos : pos + 4]
            pos += 4
        else:
            return


def _usage_grpc_web_payloads(data: bytes) -> list[bytes]:
    payloads: list[bytes] = []
    index = 0
    while index + 5 <= len(data):
        flags = data[index]
        length = int.from_bytes(data[index + 1 : index + 5], "big")
        start = index + 5
        end = start + length
        if end > len(data):
            break
        chunk = data[start:end]
        index = end
        if flags & 0x80:
            continue
        payloads.append(chunk)
    if not payloads and data:
        payloads = [data]
    return payloads


def _usage_grok_web_credits(token: str) -> tuple[float | None, str]:
    """Settings → Usage weekly SuperGrok percent from grok.com."""
    if not token:
        return None, ""
    req = urllib.request.Request(
        GROK_CREDITS_URL,
        data=b"\x00\x00\x00\x00\x00",
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "X-XAI-Token-Auth": GROK_TOKEN_AUTH,
            "Content-Type": "application/grpc-web+proto",
            "Accept": "application/grpc-web+proto",
            "X-Grpc-Web": "1",
            "Origin": "https://grok.com",
            "Referer": "https://grok.com/",
        },
    )
    try:
        with _usage_urlopen(req, timeout=20) as resp:
            raw = resp.read()
    except Exception:
        return None, ""
    percent: float | None = None
    resets = ""
    for payload in _usage_grpc_web_payloads(raw):
        config = None
        for number, wire, value in _usage_proto_fields(payload):
            if number == 1 and wire == 2 and isinstance(value, (bytes, bytearray)):
                config = bytes(value)
                break
        if config is None:
            config = payload
        for number, wire, value in _usage_proto_fields(config):
            if number == 1 and wire == 5 and isinstance(value, (bytes, bytearray)) and len(value) == 4:
                parsed = struct.unpack("<f", value)[0]
                if parsed == parsed and 0.0 <= parsed <= 100.0:
                    percent = _usage_supergrok_percent_value(parsed)
            elif number in (5, 8) and wire == 2 and isinstance(value, (bytes, bytearray)):
                period = bytes(value)
                for pnum, pwire, pval in _usage_proto_fields(period):
                    if pnum == 2 and pwire == 2 and isinstance(pval, (bytes, bytearray)):
                        text = bytes(pval).decode("utf-8", errors="replace").strip()
                        if text:
                            resets = resets or text
    return percent, resets


def _usage_grok_billing_snapshot() -> dict:
    snap = {
        "signed_in": bool(_usage_grok_auth_creds()[0]),
        "percent": None,
        "resets_at": "",
        "tier": "SuperGrok",
    }
    token, _user_id = _usage_grok_auth_creds()
    if token and _usage_jwt_is_expired(token):
        _usage_grok_refresh_auth()
        token, _user_id = _usage_grok_auth_creds()
    snap["signed_in"] = bool(token)

    billing = None
    product_total: float | None = None
    credit: float | None = None
    plan_shares: list[dict[str, Any]] = []
    unified_billing = False
    resets = ""
    for surface in ("interactive", "headless"):
        payload = _usage_grok_proxy_json("/billing?format=credits", surface=surface)
        if not isinstance(payload, dict):
            continue
        if billing is None:
            billing = payload
        cfg = payload.get("config") if isinstance(payload.get("config"), dict) else payload
        if not isinstance(cfg, dict):
            continue
        shares = _usage_plan_shares_from_config(cfg)
        if shares and (not plan_shares or len(shares) >= len(plan_shares)):
            plan_shares = shares
        if cfg.get("isUnifiedBillingUser") is True or cfg.get("is_unified_billing_user") is True:
            unified_billing = True
        parts = _usage_supergrok_weekly_parts(cfg)
        if parts.get("combined") is not None:
            product_total = (
                float(parts["combined"])
                if product_total is None
                else max(product_total, float(parts["combined"]))
            )
        if parts.get("credit") is not None:
            credit = (
                float(parts["credit"]) if credit is None else max(credit, float(parts["credit"]))
            )
        period = _usage_field(cfg, "currentPeriod", "current_period")
        period = period if isinstance(period, dict) else {}
        resets = resets or str(
            _usage_field(period, "end")
            or _usage_field(cfg, "billingPeriodEnd", "billing_period_end")
            or ""
        )

    web_percent, web_resets = _usage_grok_web_credits(token)
    resets = resets or web_resets

    if unified_billing and credit is not None:
        percent = credit
        if web_percent is not None:
            percent = max(percent, web_percent)
    elif product_total is not None:
        percent = product_total
        if web_percent is not None:
            percent = max(percent, web_percent)
        if credit is not None:
            percent = max(percent, credit)
    elif web_percent is not None:
        percent = web_percent
    else:
        percent = credit

    if percent is None and billing is None and web_percent is None and not plan_shares:
        return snap

    tier = "SuperGrok"
    if isinstance(billing, dict):
        tier = str(
            _usage_field(billing, "subscriptionTier", "subscription_tier") or ""
        ).strip() or tier
    settings = _usage_grok_proxy_json("/settings")
    if isinstance(settings, dict):
        display = str(
            _usage_field(settings, "subscription_tier_display", "subscriptionTierDisplay")
            or ""
        ).strip()
        if display:
            tier = display
    snap["percent"] = percent
    snap["resets_at"] = str(resets or "")
    snap["tier"] = tier or "SuperGrok"
    snap["unified"] = unified_billing
    if plan_shares:
        snap["planShares"] = plan_shares
    return snap


def _usage_collect_grok_local() -> dict:
    record = _usage_base_record("grok")
    grok_home = _usage_grok_home()
    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    model_usage: dict = {}
    sessions = 0

    if grok_home.is_dir():
        for path in grok_home.glob("sessions/**/updates.jsonl"):
            sessions += 1
            try:
                with path.open(encoding="utf-8", errors="replace") as handle:
                    for raw in handle:
                        raw = raw.strip()
                        if not raw:
                            continue
                        try:
                            entry = json.loads(raw)
                        except json.JSONDecodeError:
                            continue
                        if entry.get("type") != "turn_completed":
                            continue
                        usage = entry.get("usage") or {}
                        tokens = _usage_number(usage.get("total_tokens"))
                        if not tokens:
                            tokens = (
                                _usage_number(usage.get("input_tokens"))
                                + _usage_number(usage.get("output_tokens"))
                                + _usage_number(usage.get("cache_read_input_tokens"))
                                + _usage_number(usage.get("cache_creation_input_tokens"))
                            )
                        if tokens <= 0:
                            continue
                        ts = entry.get("timestamp") or entry.get("created_at") or path.stat().st_mtime
                        if isinstance(ts, (int, float)):
                            if ts > 10_000_000_000:
                                ts = ts / 1000
                            day = time.strftime("%Y-%m-%d", time.localtime(ts))
                        else:
                            day = str(ts)[:10] if ts else today
                        model = str(entry.get("model") or usage.get("model") or "grok")
                        today_tokens, total_tokens = _usage_add_tokens(
                            day,
                            model,
                            tokens,
                            today=today,
                            today_tokens=today_tokens,
                            total_tokens=total_tokens,
                            model_usage=model_usage,
                        )
            except OSError:
                continue

    record["todayTotalTokens"] = today_tokens
    record["todayPrompts"] = today_tokens
    record["todaySessions"] = sessions
    record["modelUsage"] = model_usage

    snap = _usage_grok_billing_snapshot()
    if snap.get("tier"):
        record["tierLabel"] = str(snap.get("tier") or "SuperGrok")
    if snap.get("unified") is True:
        record["unifiedBilling"] = True
    shares = snap.get("planShares")
    if isinstance(shares, list) and shares:
        record["planShares"] = shares
    percent = snap.get("percent")
    if percent is not None:
        limit = {
            "label": "Usage",
            "title": "Usage",
            "percent": percent,
        }
        resets = str(snap.get("resets_at") or "").strip()
        if resets:
            limit["resetsAt"] = resets
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "",
                "authHelpText": "",
                "limits": [limit],
            }
        )
        return record

    if snap.get("signed_in"):
        record["ready"] = True
        record["hasLocalStats"] = True
        record["usageStatusText"] = "Signed in — SuperGrok weekly quota not loaded yet"
        record["authHelpText"] = "Run `grok login`, then refresh."
        return record
    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Estimated from local Grok sessions",
                "authHelpText": "Quota bar needs `grok login` for SuperGrok Chat + Grok Build.",
            }
        )
        return record
    record["usageStatusText"] = "SuperGrok usage not loaded"
    record["authHelpText"] = (
        "Run `grok login` on this machine, then refresh SuperGrok usage."
    )
    return record


def _usage_collect_cursor_local() -> dict:
    record = _usage_base_record("cursor")
    dbs = _usage_cursor_vscdb_paths()
    if not dbs:
        record["usageStatusText"] = "Cursor database not found"
        record["authHelpText"] = (
            "Sign in to Cursor on this machine. "
            "Looked under ~/.config/Cursor, ~/.config/cursor, ~/.cursor, and snap paths."
        )
        return record

    today = _usage_today()
    today_tokens = 0
    total_tokens = 0
    prompts = 0
    model_usage: dict = {}
    errors: list[str] = []

    for db in dbs:
        try:
            t_day, t_total, t_prompts, t_models = _usage_scan_cursor_vscdb(db, today)
        except Exception as exc:
            errors.append(f"{db.name}: {exc}")
            continue
        today_tokens += t_day
        total_tokens += t_total
        prompts += t_prompts
        for model, bucket in t_models.items():
            merged = model_usage.setdefault(
                model,
                {
                    "inputTokens": 0,
                    "outputTokens": 0,
                    "cacheReadInputTokens": 0,
                    "cacheCreationInputTokens": 0,
                },
            )
            for field in merged:
                merged[field] += _usage_number(bucket.get(field))

    if total_tokens > 0:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Estimated from Cursor local state",
                "authHelpText": f"Read {len(dbs)} local DB(s); see Cursor admin console for billing.",
                "todayTotalTokens": today_tokens,
                "todayPrompts": prompts,
                "modelUsage": model_usage,
            }
        )
    elif dbs:
        record.update(
            {
                "ready": True,
                "hasLocalStats": True,
                "usageStatusText": "Signed in — no token totals in local state yet",
                "authHelpText": (
                    "Cursor local DB found; send a chat in the IDE, then refresh."
                ),
            }
        )
    else:
        record["usageStatusText"] = "No Cursor token data in local state"
        record["authHelpText"] = (
            "Sign in to Cursor on this machine and use the editor, then refresh."
            + (f" ({errors[-1]})" if errors else "")
        )
    return record


def _usage_parse_reset_datetime(value: Any) -> time.struct_time | None:
    raw = str(value or "").strip()
    if not raw:
        return None
    try:
        if raw.endswith("Z"):
            raw = raw[:-1] + "+00:00"
        dt = datetime.fromisoformat(raw)
        if dt.tzinfo is not None:
            dt = dt.astimezone()
        return dt.timetuple()
    except (ValueError, OverflowError, OSError):
        pass
    if len(raw) >= 10 and raw[4] == "-" and raw[7] == "-":
        try:
            return time.strptime(raw[:10], "%Y-%m-%d")
        except ValueError:
            return None
    return None


def _usage_reset_caption(resets_at: Any) -> str:
    reset = _usage_parse_reset_datetime(resets_at)
    if reset is None:
        return ""
    now = time.localtime()
    reset_day = time.mktime(
        (reset.tm_year, reset.tm_mon, reset.tm_mday, 0, 0, 0, 0, 0, -1)
    )
    today = time.mktime((now.tm_year, now.tm_mon, now.tm_mday, 0, 0, 0, 0, 0, -1))
    days_left = int(round((reset_day - today) / 86400))
    # A window that already reset says nothing about the current one.
    if days_left < 0 or (":" in str(resets_at) and time.mktime(reset) <= time.time()):
        return ""
    month_names = (
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sept", "Oct", "Nov", "Dec",
    )
    month = month_names[reset.tm_mon - 1]
    day = str(reset.tm_mday)
    if days_left == 0:
        tail = "resets today"
    elif days_left == 1:
        tail = "1 day left"
    else:
        tail = f"{days_left} days left"
    return f"Resets {day} {month} ({tail})"


def _usage_limit_percent(limit: dict) -> float | None:
    try:
        percent = float(limit.get("percent"))
    except (TypeError, ValueError):
        return None
    if percent != percent:
        return None
    if percent > 1:
        percent /= 100.0
    return min(1.0, max(0.0, percent))


def _usage_panel_limit(
    label: str,
    percent: float | None,
    *,
    bar_style: str = "accent",
    caption: str = "",
    resets_at: Any = None,
) -> dict:
    entry: dict[str, Any] = {
        "label": label,
        "title": label,
        "barStyle": bar_style,
        "caption": caption,
    }
    if percent is not None:
        entry["percent"] = percent
    reset = str(resets_at or "").strip()
    if reset:
        entry["resetsAt"] = reset
        reset_caption = _usage_reset_caption(reset)
        if reset_caption:
            entry["resetCaption"] = reset_caption
    return entry


def _usage_pick_limit(limits: list[dict], *needles: str) -> dict | None:
    for entry in limits:
        hay = " ".join(
            str(entry.get(key) or "")
            for key in ("label", "title", "kind", "period")
        ).lower()
        if any(needle in hay for needle in needles):
            return entry
    return None


