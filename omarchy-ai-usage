CLAUDE_TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLAUDE_OAUTH_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
CLAUDE_REFRESH_MARGIN_MS = 5 * 60 * 1000
# Cloudflare in front of the token endpoint bans Python's default User-Agent (error 1010).
CLAUDE_USER_AGENT = f"omarchy-ai-usage/{APP_VERSION}"


def _usage_claude_credentials_path() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
    return Path(os.path.expanduser(base)) / ".credentials.json"


def _usage_claude_refresh_login() -> bool:
    """Renew Claude Code's sign-in the way Claude Code does. Never logs tokens.

    Claude Code only refreshes while it runs, so a panel that just watches
    usage would find the token lapsed within hours and stop updating.
    """
    if not _usage_consented("claude"):
        return False
    path = _usage_claude_credentials_path()
    lock_path = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "omarchy-ai-usage-claude-login.lock"
    try:
        lock = open(lock_path, "w", encoding="utf-8")
    except OSError:
        return False
    with lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            login = json.loads(path.read_text(encoding="utf-8")).get("claudeAiOauth")
        except Exception:
            return False
        if not isinstance(login, dict):
            return False
        refresh = str(login.get("refreshToken") or "").strip()
        if not refresh or _usage_number(login.get("expiresAt")) - CLAUDE_REFRESH_MARGIN_MS > time.time() * 1000:
            return False

        body = {"grant_type": "refresh_token", "refresh_token": refresh, "client_id": CLAUDE_OAUTH_CLIENT_ID}
        scopes = login.get("scopes")
        if isinstance(scopes, list) and scopes:
            body["scope"] = " ".join(str(scope) for scope in scopes)
        request = urllib.request.Request(
            CLAUDE_TOKEN_URL,
            data=json.dumps(body).encode("utf-8"),
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": CLAUDE_USER_AGENT,
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                payload = json.loads(response.read().decode("utf-8", errors="replace") or "{}")
        except Exception:
            return False
        if not isinstance(payload, dict):
            return False
        access = str(payload.get("access_token") or "").strip()
        try:
            expires_in = float(payload.get("expires_in") or 0)
        except (TypeError, ValueError):
            expires_in = 0.0
        if not access or expires_in <= 0:
            return False

        # A Claude Code that renewed meanwhile holds the newer pair; keep it.
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            return False
        current = data.get("claudeAiOauth") if isinstance(data, dict) else None
        if not isinstance(current, dict) or current.get("refreshToken") != refresh:
            return False
        now_ms = time.time() * 1000
        current["accessToken"] = access
        current["refreshToken"] = str(payload.get("refresh_token") or refresh)
        current["expiresAt"] = int(now_ms + expires_in * 1000)
        refresh_life = _usage_number(payload.get("refresh_token_expires_in"))
        if refresh_life > 0:
            current["refreshTokenExpiresAt"] = int(now_ms + refresh_life * 1000)
        scope = payload.get("scope")
        if isinstance(scope, str) and scope.strip():
            current["scopes"] = scope.split()

        try:
            _usage_write_private_json(path, data)
        except OSError:
            return False
        return True


CLAUDE_SCOPED_WINDOWS = (
    (" Session", "Current session"),
    (" Weekly", "Current week"),
    (" Monthly", "Current month"),
)


def _usage_claude_reset_caption(resets_at: Any) -> str:
    """Windows closing within a day read better as a clock time than a date."""
    reset_ts = _usage_parse_updated_at(resets_at)
    if reset_ts is None:
        return ""
    seconds_left = reset_ts - time.time()
    if seconds_left >= 86400:
        return _usage_reset_caption(resets_at)
    reset_local = time.localtime(reset_ts)
    clock = time.strftime("%H:%M", reset_local)
    if reset_local.tm_yday != time.localtime().tm_yday:
        clock = "tomorrow " + clock
    minutes = int(seconds_left // 60)
    if minutes < 1:
        return f"Resets {clock}"
    if minutes < 60:
        return f"Resets {clock} ({minutes} min left)"
    return f"Resets {clock} ({minutes // 60} h {minutes % 60} min left)"


def _usage_claude_panel_limits(limits: list[dict]) -> list[dict]:
    """Map omarchy-agent-usage-claude windows onto claude.ai's usage wording."""
    rows: list[dict] = []
    for entry in limits:
        percent = _usage_limit_percent(entry)
        if percent is None:
            continue
        label = str(entry.get("title") or entry.get("label") or "").strip()
        bar_style = "accent"
        if label.startswith("Session ("):
            label = "Current session"
        elif label.startswith("Weekly ("):
            label = "Current week · All models"
        else:
            # Model-scoped windows arrive as "<model> <Window>", e.g. "Opus 5 Weekly".
            for suffix, window in CLAUDE_SCOPED_WINDOWS:
                if label.endswith(suffix) and len(label) > len(suffix):
                    label = f"{window} · {label[: -len(suffix)].strip()}"
                    break
            bar_style = "muted"
        resets_at = entry.get("resetsAt")
        rows.append(
            _usage_panel_limit(
                label or "Usage",
                percent,
                bar_style=bar_style,
                caption=_usage_claude_reset_caption(resets_at),
                resets_at=resets_at,
            )
        )
    return rows


def _usage_claude_checked_ago() -> str:
    cache = (
        Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
        / "omarchy" / "agent-usage" / "claude-limits.json"
    )
    try:
        fetched = float(json.loads(cache.read_text(encoding="utf-8")).get("fetchedAtMs") or 0) / 1000
    except Exception:
        return ""
    if fetched <= 0:
        return ""
    minutes = max(0, int((time.time() - fetched) // 60))
    if minutes < 60:
        return f"{minutes} min ago"
    if minutes < 48 * 60:
        return f"{minutes // 60} h ago"
    return f"{minutes // 1440} days ago"


def _usage_claude_notice(usage_status: str, panel_limits: list[dict]) -> str:
    """The collector keeps its last numbers once the sign-in lapses; say so."""
    if not panel_limits or usage_status.lower() != "sign-in expired":
        return ""
    ago = _usage_claude_checked_ago()
    checked = f"Last checked {ago}" if ago else "Last known numbers"
    return f"{checked}: Claude Code's sign-in expired. Start Claude Code or run `claude auth login` to refresh."


def _usage_panel_limits(agent_id: str, limits: list[dict]) -> list[dict]:
    if agent_id == "cursor":
        return _usage_cursor_panel_limits(limits)
    if agent_id == "grokbot":
        return _usage_grokbot_panel_limits(limits)
    if agent_id == "grok":
        return _usage_grok_build_panel_limits(limits)
    if agent_id == "claude":
        return _usage_claude_panel_limits(limits)
    return limits


def _usage_normalize_auth_help(agent_id: str, record: dict) -> tuple[str, str]:
    usage_status = str(record.get("usageStatusText") or "").strip()
    auth_help = str(record.get("authHelpText") or "").strip()
    if auth_help.lower() == "initialize":
        if agent_id == "grok":
            auth_help = "Run `grok login`, then refresh SuperGrok usage."
        else:
            auth_help = "Sign in to Cursor on this machine, then refresh."
    if agent_id == "grokbot" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = "Sign in to Cursor to refresh Grok Bot's weekly limit."
    if agent_id == "grok" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = "Run `grok login` to refresh SuperGrok limits; local stats may still apply."
    if agent_id == "claude":
        auth_help = auth_help.replace(" Local Claude Code stats are still shown.", "")
        if usage_status.lower() == "waiting for auth":
            auth_help = USAGE_MISSING_HELP["claude"][1]
    return usage_status, auth_help


def _usage_grok_sign_in_lapsed() -> bool:
    token, _user_id = _usage_grok_auth_creds()
    return bool(token) and _usage_jwt_is_expired(token)


def _usage_sign_in_lapsed(agent_id: str, usage_status: str) -> bool:
    if agent_id == "claude":
        return usage_status.lower() == "sign-in expired"
    if agent_id == "grok":
        return _usage_grok_sign_in_lapsed()
    return False


def _usage_notice(agent_id: str, usage_status: str, panel_limits: list[dict]) -> str:
    if agent_id == "claude":
        return _usage_claude_notice(usage_status, panel_limits)
    if agent_id == "grok" and _usage_grok_sign_in_lapsed():
        return "The grok CLI's sign-in expired. Run `grok login` to refresh it."
    return ""


def _usage_panel_agent(agent_id: str, record: dict | None) -> dict:
    if record is None:
        status, help_text = USAGE_MISSING_HELP.get(
            agent_id, ("No usage data yet", "Open the panel again to collect usage.")
        )
        return {
            "id": agent_id,
            "name": AGENT_USAGE_NAMES.get(agent_id, agent_id),
            "available": False,
            "ready": False,
            "tierLabel": "",
            "usageStatusText": status,
            "authHelpText": help_text,
            "todayTotalTokens": 0,
            "todayPrompts": 0,
            "limits": [],
            "notice": "",
            "renewOffered": False,
            "updatedAt": _usage_now_iso(),
        }

    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    panel_limits = _usage_panel_limits(agent_id, limits)
    usage_status, auth_help = _usage_normalize_auth_help(agent_id, record)
    ready = record.get("ready") is True
    has_stats = record.get("hasLocalStats") is True or bool(record.get("modelUsage"))
    has_tokens = _usage_number(record.get("todayTotalTokens")) > 0
    has_prompts = _usage_number(record.get("todayPrompts")) > 0
    has_limits = bool(panel_limits)
    has_tier = bool(str(record.get("tierLabel") or "").strip())
    available = ready or has_stats or has_limits or has_tier or has_tokens or has_prompts
    return {
        "id": agent_id,
        "name": str(record.get("name") or AGENT_USAGE_NAMES.get(agent_id, agent_id)),
        "available": available,
        "ready": ready,
        "tierLabel": str(record.get("tierLabel") or ""),
        "usageStatusText": usage_status,
        "authHelpText": auth_help,
        "todayTotalTokens": _usage_number(record.get("todayTotalTokens")),
        "todayPrompts": _usage_number(record.get("todayPrompts")),
        "limits": panel_limits,
        "notice": _usage_notice(agent_id, usage_status, panel_limits),
        # Offered only while a sign-in has lapsed and nobody has said yes yet.
        "renewOffered": (
            agent_id in RENEWABLE_SIGN_INS
            and not _usage_consented(agent_id)
            and _usage_sign_in_lapsed(agent_id, usage_status)
        ),
        "updatedAt": str(record.get("updatedAt") or _usage_now_iso()),
    }


def cmd_ai_usage(refresh: bool = False) -> int:
    missing = any(_usage_read_record(agent_id) is None for agent_id in AGENT_USAGE_IDS)
    stale = any(_usage_record_is_stale(_usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS)
    if refresh:
        cmd_ai_usage_update()
        missing = any(_usage_read_record(agent_id) is None for agent_id in AGENT_USAGE_IDS)
        stale = any(_usage_record_is_stale(_usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS)
    agents = [_usage_panel_agent(agent_id, _usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS]
    print(json.dumps(
        {
            "agents": agents,
            "updatedAt": _usage_now_iso(),
            "stale": bool(missing or stale),
        },
        separators=(",", ":"),
    ))
    return 0


def cmd_ai_usage_update() -> int:
    USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)

    _usage_run_collector("grokbot")
    collector_record = _usage_read_record("grokbot")
    local_bot = _usage_collect_grokbot_local()
    if isinstance(local_bot.get("limits"), list) and local_bot["limits"]:
        _usage_write_record("grokbot", local_bot)
    else:
        merged = _usage_merge_records(collector_record, local_bot, agent_id="grokbot")
        _usage_write_record("grokbot", merged)
    if _usage_read_record("grokbot") is None:
        record = _usage_base_record("grokbot")
        record["usageStatusText"] = "Grok Bot usage unavailable"
        record["authHelpText"] = USAGE_MISSING_HELP["grokbot"][1]
        _usage_write_record("grokbot", record)

    for agent_id, local_collector in (
        ("cursor", _usage_collect_cursor_local),
        ("grok", _usage_collect_grok_local),
    ):
        _usage_run_collector(agent_id)
        collector_record = _usage_read_record(agent_id)
        local_record = local_collector()
        merged = _usage_merge_records(
            collector_record,
            local_record,
            agent_id=agent_id,
        )

        if agent_id == "cursor":
            live = _usage_fetch_cursor_live()
            if live is not None:
                live_limits = live.get("limits") if isinstance(live.get("limits"), list) else []
                if live_limits:
                    merged["limits"] = live_limits
                    merged["ready"] = True
                    if live.get("tierLabel"):
                        merged["tierLabel"] = live["tierLabel"]
                    merged["authHelpText"] = live.get("authHelpText") or ""
                    merged["updatedAt"] = live.get("updatedAt") or merged.get("updatedAt")
        elif agent_id == "grok":
            live_limits = local_record.get("limits") if isinstance(local_record.get("limits"), list) else []
            if live_limits:
                merged["limits"] = live_limits
                merged["ready"] = True
                if local_record.get("tierLabel"):
                    merged["tierLabel"] = local_record["tierLabel"]
                merged["usageStatusText"] = local_record.get("usageStatusText") or ""
                merged["authHelpText"] = local_record.get("authHelpText") or ""
                merged["updatedAt"] = _usage_now_iso()

        _usage_write_record(agent_id, merged)

    _usage_claude_refresh_login()
    claude_ok, claude_err = _usage_run_collector("claude", "--limits-only")
    if not claude_ok and _usage_read_record("claude") is None:
        record = _usage_base_record("claude")
        record["usageStatusText"] = "Claude usage unavailable"
        record["authHelpText"] = claude_err or USAGE_MISSING_HELP["claude"][1]
        _usage_write_record("claude", record)

    return 0


def cmd_consent(provider: str, value: str | None) -> int:
    renew = _usage_load_consent()
    if value is None:
        print("on" if renew.get(provider) is True else "off")
        return 0
    renew[provider] = value == "on"
    CONSENT_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONSENT_FILE.with_name(f".{CONSENT_FILE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"renew": renew}, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONSENT_FILE)
    print(f"{provider} sign-in renewal: {value}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="AI Usage backend for the Omarchy bar panel")
    parser.add_argument("--version", action="version", version=APP_VERSION)
    sub = parser.add_subparsers(dest="command")

    read = sub.add_parser("read", help="Print the panel JSON for Cursor, Grok Bot, SuperGrok, and Claude")
    read.add_argument("--refresh", action="store_true", help="Run update before reading the state files")
    sub.add_parser("update", help="Refresh the usage state files")
    consent = sub.add_parser(
        "consent",
        help="Allow or forbid renewing a lapsed sign-in (rewrites that app's credential file)",
    )
    consent.add_argument("provider", choices=RENEWABLE_SIGN_INS)
    consent.add_argument("value", nargs="?", choices=("on", "off"), help="Omit to print the current setting")

    args = parser.parse_args(argv)
    if args.command == "read":
        return cmd_ai_usage(refresh=args.refresh)
    if args.command == "update":
        return cmd_ai_usage_update()
    if args.command == "consent":
        return cmd_consent(args.provider, args.value)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())


