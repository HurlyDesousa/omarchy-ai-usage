def _usage_normalize_auth_help(agent_id: str, record: dict) -> tuple[str, str]:
    usage_status = str(record.get("usageStatusText") or "").strip()
    auth_help = str(record.get("authHelpText") or "").strip()
    if auth_help.lower() == "initialize":
        if agent_id == "grok":
            auth_help = "Run `grok login`, then refresh SuperGrok usage."
        else:
            auth_help = "Sign in to Cursor on this machine, then refresh."
    if agent_id == "grokbot" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = "Sign in to Cursor to refresh Grok Bot's weekly limit."
    if agent_id == "grok" and "limits unavailable" in usage_status.lower():
        if not auth_help or auth_help.lower() == "initialize":
            auth_help = "Run `grok login` to refresh SuperGrok limits; local stats may still apply."
    if agent_id == "claude":
        auth_help = auth_help.replace(" Local Claude Code stats are still shown.", "")
        if usage_status.lower() == "waiting for auth":
            auth_help = USAGE_MISSING_HELP["claude"][1]
    return usage_status, auth_help


def _usage_grok_sign_in_lapsed() -> bool:
    token, _user_id = _usage_grok_auth_creds()
    return bool(token) and _usage_jwt_is_expired(token)


def _usage_sign_in_lapsed(agent_id: str, usage_status: str) -> bool:
    if agent_id == "claude":
        return usage_status.lower() == "sign-in expired"
    if agent_id == "grok":
        return _usage_grok_sign_in_lapsed()
    return False


def _usage_ago(timestamp: float) -> str:
    minutes = max(0, int((time.time() - timestamp) // 60))
    if minutes < 60:
        return f"{minutes} min ago"
    if minutes < 48 * 60:
        return f"{minutes // 60} h ago"
    return f"{minutes // 1440} days ago"


def _usage_notice(agent_id: str, usage_status: str, panel_limits: list[dict], record: dict) -> str:
    if agent_id == "claude":
        return _usage_claude_notice(usage_status, panel_limits)
    if agent_id == "grok" and _usage_grok_sign_in_lapsed():
        return "The grok CLI's sign-in expired. Run `grok login` to refresh it."
    fetched = _usage_parse_updated_at(record.get("limitsFetchedAt"))
    if panel_limits and fetched is not None and time.time() - fetched > 2 * USAGE_STALE_SECONDS:
        renew = record.get("authHelpText") == CURSOR_RENEW_HELP
        return f"Last checked {_usage_ago(fetched)}." + (f" {CURSOR_RENEW_HELP}" if renew else "")
    return ""


def _usage_panel_agent(agent_id: str, record: dict | None) -> dict:
    if record is None:
        status, help_text = USAGE_MISSING_HELP.get(
            agent_id, ("No usage data yet", "Open the panel again to collect usage.")
        )
        return {
            "id": agent_id,
            "name": AGENT_USAGE_NAMES.get(agent_id, agent_id),
            "available": False,
            "ready": False,
            "tierLabel": "",
            "usageStatusText": status,
            "authHelpText": help_text,
            "todayTotalTokens": 0,
            "todayPrompts": 0,
            "limits": [],
            "notice": "",
            "renewOffered": False,
            "updatedAt": _usage_now_iso(),
        }

    limits = record.get("limits") if isinstance(record.get("limits"), list) else []
    panel_limits = _usage_panel_limits(agent_id, [limit for limit in limits if isinstance(limit, dict)])
    usage_status, auth_help = _usage_normalize_auth_help(agent_id, record)
    ready = record.get("ready") is True
    has_stats = record.get("hasLocalStats") is True or bool(record.get("modelUsage"))
    has_tokens = _usage_number(record.get("todayTotalTokens")) > 0
    has_prompts = _usage_number(record.get("todayPrompts")) > 0
    has_limits = bool(panel_limits)
    has_tier = bool(str(record.get("tierLabel") or "").strip())
    available = ready or has_stats or has_limits or has_tier or has_tokens or has_prompts
    payload = {
        "id": agent_id,
        "name": str(record.get("name") or AGENT_USAGE_NAMES.get(agent_id, agent_id)),
        "available": available,
        "ready": ready,
        "tierLabel": str(record.get("tierLabel") or ""),
        "usageStatusText": usage_status,
        "authHelpText": auth_help,
        "todayTotalTokens": _usage_number(record.get("todayTotalTokens")),
        "todayPrompts": _usage_number(record.get("todayPrompts")),
        "limits": panel_limits,
        "notice": _usage_notice(agent_id, usage_status, panel_limits, record),
        # Offered only while a sign-in has lapsed and nobody has said yes yet.
        "renewOffered": (
            agent_id in RENEWABLE_SIGN_INS
            and not _usage_consented(agent_id)
            and _usage_sign_in_lapsed(agent_id, usage_status)
        ),
        "updatedAt": str(record.get("updatedAt") or _usage_now_iso()),
    }
    shares = record.get("planShares")
    if isinstance(shares, list) and shares:
        payload["planShares"] = shares
    if record.get("unifiedBilling") is True:
        payload["unifiedBilling"] = True
    return payload


def _usage_limit_entry_percent(limit: dict | None) -> float | None:
    if not isinstance(limit, dict):
        return None
    value = limit.get("percent")
    if value is None:
        return None
    try:
        percent = float(value)
    except (TypeError, ValueError):
        return None
    if not (percent == percent):  # NaN
        return None
    if percent > 1:
        percent /= 100.0
    return min(1.0, max(0.0, percent))


def _usage_spacexai_panel_agent(providers: dict[str, dict]) -> dict:
    """One SpaceXAI plan meter plus Cursor / Grok Bot / Chat pool shares."""
    cursor = providers.get("cursor") or {}
    grokbot = providers.get("grokbot") or {}
    grok = providers.get("grok") or {}

    cursor_limits = [limit for limit in (cursor.get("limits") or []) if isinstance(limit, dict)]
    cursor_main = cursor_limits[0] if cursor_limits else None
    bot = next((limit for limit in (grokbot.get("limits") or []) if isinstance(limit, dict)), None)
    build = next((limit for limit in (grok.get("limits") or []) if isinstance(limit, dict)), None)

    shared = []
    for limit in (cursor_main, bot, build):
        percent = _usage_limit_entry_percent(limit)
        if percent is not None:
            shared.append((percent, limit))
    unified = max((item[0] for item in shared), default=None)
    reset_source = next((item[1] for item in shared), {}) or {}

    breakdown: list[dict[str, Any]] = []
    plan_shares = grok.get("planShares") if isinstance(grok.get("planShares"), list) else []
    if plan_shares:
        for share in plan_shares:
            if not isinstance(share, dict):
                continue
            percent = _usage_limit_entry_percent(share)
            if percent is None:
                continue
            breakdown.append(
                {
                    "id": str(share.get("id") or share.get("label") or "share"),
                    "label": str(share.get("label") or share.get("id") or "Usage"),
                    "detail": "",
                    "percent": percent,
                    "barStyle": str(share.get("barStyle") or "accent"),
                }
            )
        share_total = sum(float(row["percent"]) for row in breakdown)
        if share_total > 0:
            unified = max(unified or 0.0, min(1.0, share_total))
    else:
        if cursor_main is not None and _usage_limit_entry_percent(cursor_main) is not None:
            breakdown.append(
                {
                    "id": "cursor",
                    "label": "Cursor",
                    "detail": "",
                    "percent": _usage_limit_entry_percent(cursor_main),
                    "barStyle": "accent",
                }
            )
        if bot is not None and _usage_limit_entry_percent(bot) is not None:
            breakdown.append(
                {
                    "id": "grokbot",
                    "label": "Grok Bot",
                    "detail": "",
                    "percent": _usage_limit_entry_percent(bot),
                    "barStyle": "grokbot",
                }
            )
        if build is not None and _usage_limit_entry_percent(build) is not None:
            breakdown.append(
                {
                    "id": "chat",
                    "label": "Chat",
                    "detail": "",
                    "percent": _usage_limit_entry_percent(build),
                    "barStyle": "muted",
                }
            )

    available = any(bool(agent.get("available")) for agent in (cursor, grokbot, grok))
    ready = any(bool(agent.get("ready")) for agent in (cursor, grokbot, grok))
    status_parts = [
        str(agent.get("usageStatusText") or "").strip()
        for agent in (cursor, grokbot, grok)
        if str(agent.get("usageStatusText") or "").strip()
    ]
    help_parts = [
        str(agent.get("authHelpText") or "").strip()
        for agent in (cursor, grokbot, grok)
        if str(agent.get("authHelpText") or "").strip()
    ]
    # Prefer Cursor's live-dashboard note; fall back to the first useful line.
    auth_help = ""
    for text_help in help_parts:
        if "Live Cursor" in text_help or "dashboard" in text_help.lower():
            auth_help = text_help
            break
    if not auth_help and help_parts:
        auth_help = help_parts[0]
    usage_status = status_parts[0] if status_parts else ""
    if available and breakdown:
        usage_status = ""
        auth_help = auth_help if "expired" in auth_help.lower() or "sign" in auth_help.lower() else ""

    tier = str(cursor.get("tierLabel") or "").strip()
    if not tier:
        tier = str(grok.get("tierLabel") or "").strip()
    if not tier:
        tier = "SpaceXAI Plan"

    updated_candidates = [
        str(agent.get("updatedAt") or "")
        for agent in (cursor, grokbot, grok)
        if agent.get("updatedAt")
    ]
    updated_at = max(updated_candidates) if updated_candidates else _usage_now_iso()

    limits = []
    if unified is not None:
        limits.append(
            _usage_panel_limit(
                "Usage",
                unified,
                bar_style="accent",
                caption=(
                    "Shared SpaceXAI weekly allowance. Breakdown is each product's share of that pool."
                ),
                resets_at=reset_source.get("resetsAt"),
            )
        )

    return {
        "id": "spacexai",
        "name": "SpaceXAI",
        "available": available,
        "ready": ready,
        "tierLabel": tier,
        "usageStatusText": usage_status,
        "authHelpText": auth_help,
        "todayTotalTokens": 0,
        "todayPrompts": 0,
        "limits": limits,
        "breakdown": breakdown,
        "notice": str(grok.get("notice") or ""),
        "renewOffered": bool(grok.get("renewOffered")),
        "updatedAt": updated_at,
    }


def cmd_ai_usage(refresh: bool = False) -> int:
    missing = any(_usage_read_record(agent_id) is None for agent_id in AGENT_USAGE_IDS)
    stale = any(_usage_record_is_stale(_usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS)
    if refresh:
        cmd_ai_usage_update()
        missing = any(_usage_read_record(agent_id) is None for agent_id in AGENT_USAGE_IDS)
        stale = any(_usage_record_is_stale(_usage_read_record(agent_id)) for agent_id in AGENT_USAGE_IDS)
    providers = {
        agent_id: _usage_panel_agent(agent_id, _usage_read_record(agent_id))
        for agent_id in AGENT_USAGE_IDS
    }
    agents = [_usage_spacexai_panel_agent(providers)]
    print(json.dumps(
        {
            "agents": agents,
            "updatedAt": _usage_now_iso(),
            "stale": bool(missing or stale),
        },
        separators=(",", ":"),
    ))
    return 0


CURSOR_RENEW_HELP = "Cursor's sign-in expired. Open Cursor to renew it, then refresh."


def _usage_carry_limits(previous: dict | None, record: dict) -> dict:
    """No live numbers this run: keep the last ones with the time they were
    fetched, so the panel marks them stale instead of passing them off as new.
    Windows that have reset since are dropped; their numbers no longer apply."""
    old = previous.get("limits") if isinstance(previous, dict) and isinstance(previous.get("limits"), list) else []
    now = time.time()
    kept = []
    for limit in old:
        if not isinstance(limit, dict):
            continue
        reset = _usage_parse_updated_at(limit.get("resetsAt"))
        if reset is not None and reset <= now:
            continue
        kept.append(limit)
    if not kept:
        return record
    fetched = previous.get("limitsFetchedAt") or previous.get("updatedAt") or record.get("updatedAt")
    carried = dict(record)
    carried.update({"limits": kept, "ready": True, "limitsFetchedAt": fetched, "updatedAt": fetched})
    if not carried.get("tierLabel") and previous.get("tierLabel"):
        carried["tierLabel"] = previous["tierLabel"]
    return carried


def _usage_collect_cursor() -> dict:
    record = _usage_collect_cursor_local()
    live = _usage_fetch_cursor_live()
    live_limits = live.get("limits") if isinstance(live, dict) and isinstance(live.get("limits"), list) else []
    if live_limits:
        record.update(
            {
                "limits": live_limits,
                "ready": True,
                "authHelpText": live.get("authHelpText") or "",
                "updatedAt": live.get("updatedAt") or record.get("updatedAt"),
            }
        )
        if live.get("tierLabel"):
            record["tierLabel"] = live["tierLabel"]
    elif not _usage_cursor_bearer():
        record["authHelpText"] = CURSOR_RENEW_HELP
    return record


def _usage_collect_grokbot() -> dict:
    record = _usage_collect_grokbot_local()
    if not record.get("limits") and not _usage_cursor_bearer():
        record["authHelpText"] = CURSOR_RENEW_HELP
    return record


def _usage_update_provider(agent_id: str, collect) -> None:
    # Built from this run only: merging the previous file kept old numbers
    # under a fresh timestamp, and summed counters on every update.
    previous = _usage_read_record(agent_id)
    record = collect()
    if isinstance(record.get("limits"), list) and record["limits"]:
        record["limitsFetchedAt"] = record.get("updatedAt") or _usage_now_iso()
    else:
        record = _usage_carry_limits(previous, record)
    _usage_write_record(agent_id, record)


def _usage_deadline(_signum, _frame):
    raise _UsageDeadline("update exceeded its time limit")


def cmd_ai_usage_update() -> int:
    USAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
    signal.signal(signal.SIGALRM, _usage_deadline)
    signal.alarm(USAGE_UPDATE_DEADLINE_SECONDS)
    failed: list[str] = []

    # One provider's bad data must not stop the others.
    for agent_id, collect in (
        ("grokbot", _usage_collect_grokbot),
        ("cursor", _usage_collect_cursor),
        ("grok", _usage_collect_grok_local),
    ):
        try:
            _usage_update_provider(agent_id, collect)
        except _UsageDeadline:
            raise
        except Exception as exc:
            failed.append(f"{agent_id}: {type(exc).__name__}")

    for line in failed:
        print(f"update {line}", file=sys.stderr)
    return 1 if failed else 0


def cmd_consent(provider: str, value: str | None) -> int:
    renew = _usage_load_consent()
    if value is None:
        print("on" if renew.get(provider) is True else "off")
        return 0
    renew[provider] = value == "on"
    CONSENT_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONSENT_FILE.with_name(f".{CONSENT_FILE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps({"renew": renew}, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONSENT_FILE)
    print(f"{provider} sign-in renewal: {value}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="AI Usage backend for the Omarchy bar panel")
    parser.add_argument("--version", action="version", version=APP_VERSION)
    sub = parser.add_subparsers(dest="command")

    read = sub.add_parser("read", help="Print the panel JSON for the shared SpaceXAI plan")
    read.add_argument("--refresh", action="store_true", help="Run update before reading the state files")
    sub.add_parser("update", help="Refresh the usage state files")
    consent = sub.add_parser(
        "consent",
        help="Allow or forbid renewing a lapsed sign-in (rewrites that app's credential file)",
    )
    consent.add_argument("provider", choices=RENEWABLE_SIGN_INS)
    consent.add_argument("value", nargs="?", choices=("on", "off"), help="Omit to print the current setting")

    args = parser.parse_args(argv)
    if args.command == "read":
        return cmd_ai_usage(refresh=args.refresh)
    if args.command == "update":
        return cmd_ai_usage_update()
    if args.command == "consent":
        return cmd_consent(args.provider, args.value)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())


